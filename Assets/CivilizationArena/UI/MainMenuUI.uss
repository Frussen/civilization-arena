:root {
    --menu-background: rgb(22, 25, 29);
    --card-background: rgb(31, 35, 40);
    --card-border: rgb(76, 82, 90);
    --button-background: rgb(43, 48, 54);
    --button-hover: rgb(55, 61, 68);
    --text-primary: rgb(232, 235, 238);
    --text-secondary: rgb(157, 165, 174);
    --accent: rgb(207, 158, 54);
}

.menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--menu-background);
    color: var(--text-primary);
}

.menu-card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(9, 11, 14, 0.87);
}

.menu-card {
    width: 520px;
    height: 536px;
    min-height: 536px;
    flex-shrink: 0;
    padding: 36px 54px;
    align-items: center;
    background-color: var(--card-background);
    background-image: url("Images/MainMenuBackground.jpeg");
    -unity-background-scale-mode: scale-and-crop;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--card-border);
    border-right-color: var(--card-border);
    border-bottom-color: var(--card-border);
    border-left-color: var(--card-border);
}

.menu-view {
    width: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.game-title {
    min-height: 48px;
    color: var(--accent);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-subtitle {
    margin-top: 4px;
    margin-bottom: 22px;
    color: var(--text-secondary);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.mode-list {
    width: 100%;
}

.mode-row {
    min-height: 68px;
    margin-bottom: 6px;
}

.mode-button {
    height: 48px;
    margin: 0;
    background-color: var(--button-background);
    color: var(--text-primary);
    border-top-color: var(--card-border);
    border-right-color: var(--card-border);
    border-bottom-color: var(--card-border);
    border-left-color: var(--card-border);
    font-size: 15px;
    -unity-font-style: bold;
}

.mode-button:hover {
    background-color: var(--button-hover);
}

.mode-button:disabled {
    opacity: 0.5;
    color: var(--text-secondary);
}

.primary-button {
    background-color: rgb(151, 105, 25);
    border-top-color: var(--accent);
    border-right-color: var(--accent);
    border-bottom-color: var(--accent);
    border-left-color: var(--accent);
}

.primary-button:hover {
    background-color: rgb(177, 126, 33);
}

.availability-label {
    height: 18px;
    color: rgb(119, 127, 136);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.available-label {
    color: var(--accent);
}

.configuration-title {
    margin-top: 2px;
    margin-bottom: 26px;
    color: var(--text-primary);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.configuration-form {
    width: 100%;
}

.configuration-field-row {
    width: 100%;
}

.settings-form {
    width: 100%;
}

.settings-control-row {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
}

.settings-slider {
    flex-grow: 1;
    margin-right: 12px;
}

.settings-value-label {
    width: 48px;
    color: var(--text-primary);
    -unity-text-align: middle-right;
}

.settings-toggle {
    height: 38px;
    color: var(--text-primary);
}

.field-label {
    height: 18px;
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 10px;
    letter-spacing: 1px;
}

.configuration-field {
    height: 38px;
    margin: 0 0 5px 0;
}

.configuration-field > .unity-base-field__input {
    min-height: 34px;
    background-color: var(--button-background);
    color: var(--text-primary);
    border-top-color: var(--card-border);
    border-right-color: var(--card-border);
    border-bottom-color: var(--card-border);
    border-left-color: var(--card-border);
}

.configuration-error {
    min-height: 22px;
    margin-top: 8px;
    color: rgb(232, 112, 102);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.configuration-actions {
    width: 100%;
    margin-top: 22px;
    flex-direction: row;
}

.configuration-button {
    flex-grow: 1;
}

.configuration-back-button {
    margin-right: 6px;
}

.configuration-start-button {
    margin-left: 6px;
}

.ai-side-columns {
    width: 100%;
    flex-direction: row;
}

.ai-side-section {
    flex-grow: 1;
    width: 50%;
}

.ai-side-a-section {
    margin-right: 8px;
}

.ai-side-b-section {
    margin-left: 8px;
}

.ai-side-title {
    height: 24px;
    margin-bottom: 4px;
    color: var(--accent);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
