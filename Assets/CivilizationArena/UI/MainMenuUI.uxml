<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenuUI.uss" />
    <ui:VisualElement class="menu-root">
        <ui:VisualElement class="menu-card">
            <ui:VisualElement class="menu-card-overlay" />
            <ui:VisualElement name="mode-selection-view" class="menu-view">
                <ui:Label text="CIVILIZATION ARENA" class="game-title" />
                <ui:Label text="Choose game mode" class="menu-subtitle" />

                <ui:VisualElement class="mode-list">
                    <ui:VisualElement class="mode-row">
                        <ui:Button name="ai-arena-button" text="AI ARENA" class="mode-button primary-button" />
                        <ui:Label text="AI VS AI" class="availability-label available-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="mode-row">
                        <ui:Button name="single-player-button" text="SINGLE PLAYER" class="mode-button primary-button" />
                        <ui:Label text="MANUAL VS AI" class="availability-label available-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="mode-row">
                        <ui:Button name="local-multiplayer-button" text="LOCAL MULTIPLAYER" class="mode-button primary-button" />
                        <ui:Label text="MANUAL VS MANUAL" class="availability-label available-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="mode-row">
                        <ui:Button name="settings-button" text="SETTINGS" class="mode-button" />
                        <ui:Label text="AUDIO &amp; DISPLAY" class="availability-label available-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="mode-row">
                        <ui:Button name="online-multiplayer-button" text="ONLINE MULTIPLAYER" enabled="false" class="mode-button" />
                        <ui:Label text="COMING SOON" class="availability-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="settings-view" class="menu-view configuration-view" style="display: none;">
                <ui:Label text="CIVILIZATION ARENA" class="game-title" />
                <ui:Label text="SETTINGS" class="configuration-title" />

                <ui:VisualElement class="settings-form">
                    <ui:Label text="MUSIC VOLUME" class="field-label" />
                    <ui:VisualElement class="settings-control-row">
                        <ui:Slider name="music-volume-slider" low-value="0" high-value="100" class="settings-slider" />
                        <ui:Label name="music-volume-value-label" text="25%" class="settings-value-label" />
                    </ui:VisualElement>

                    <ui:Label text="SFX VOLUME" class="field-label" />
                    <ui:VisualElement class="settings-control-row">
                        <ui:Slider name="sfx-volume-slider" low-value="0" high-value="100" class="settings-slider" />
                        <ui:Label name="sfx-volume-value-label" text="50%" class="settings-value-label" />
                    </ui:VisualElement>

                    <ui:Label text="FULLSCREEN" class="field-label" />
                    <ui:Toggle name="fullscreen-toggle" text="Enabled" class="settings-toggle" />
                </ui:VisualElement>

                <ui:VisualElement class="configuration-actions">
                    <ui:Button name="settings-back-button" text="BACK" class="configuration-button mode-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="single-player-configuration-view" class="menu-view configuration-view" style="display: none;">
                <ui:Label text="CIVILIZATION ARENA" class="game-title" />
                <ui:Label text="SINGLE PLAYER" class="configuration-title" />

                <ui:VisualElement name="single-player-ai-fields" class="configuration-form ai-side-fields">
                    <ui:VisualElement class="configuration-field-row">
                        <ui:Label text="AI PROVIDER" class="field-label" />
                        <ui:DropdownField name="ai-provider-field" class="configuration-field ai-provider-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="configuration-field-row openai-model-row">
                        <ui:Label text="MODEL" class="field-label" />
                        <ui:DropdownField name="model-field" class="configuration-field openai-model-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="configuration-field-row api-key-row">
                        <ui:Label text="API KEY" class="field-label" />
                        <ui:TextField name="api-key-field" is-password-field="true" class="configuration-field api-key-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="configuration-field-row local-endpoint-row" style="display: none;">
                        <ui:Label text="LOCAL ENDPOINT" class="field-label" />
                        <ui:TextField name="local-endpoint-field" class="configuration-field local-endpoint-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="configuration-field-row local-model-row" style="display: none;">
                        <ui:Label text="MODEL" class="field-label" />
                        <ui:TextField name="local-model-field" class="configuration-field local-model-field" />
                    </ui:VisualElement>

                    <ui:Label name="configuration-error-label" class="configuration-error" style="display: none;" />
                </ui:VisualElement>

                <ui:VisualElement class="configuration-actions">
                    <ui:Button name="configuration-back-button" text="BACK" class="configuration-button configuration-back-button mode-button" />
                    <ui:Button name="start-match-button" text="START MATCH" class="configuration-button configuration-start-button mode-button primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ai-arena-configuration-view" class="menu-view configuration-view" style="display: none;">
                <ui:Label text="CIVILIZATION ARENA" class="game-title" />
                <ui:Label text="AI ARENA" class="configuration-title" />

                <ui:VisualElement class="ai-side-columns">
                    <ui:VisualElement name="ai-arena-side-a-ai-fields" class="ai-side-section ai-side-a-section ai-side-fields">
                        <ui:Label text="SIDE A" class="ai-side-title" />

                        <ui:VisualElement class="configuration-field-row">
                            <ui:Label text="AI PROVIDER" class="field-label" />
                            <ui:DropdownField name="ai-arena-side-a-provider-field" class="configuration-field ai-provider-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row openai-model-row">
                            <ui:Label text="MODEL" class="field-label" />
                            <ui:DropdownField name="ai-arena-side-a-model-field" class="configuration-field openai-model-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row api-key-row">
                            <ui:Label text="API KEY" class="field-label" />
                            <ui:TextField name="ai-arena-side-a-api-key-field" is-password-field="true" class="configuration-field api-key-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row local-endpoint-row" style="display: none;">
                            <ui:Label text="LOCAL ENDPOINT" class="field-label" />
                            <ui:TextField name="ai-arena-side-a-local-endpoint-field" class="configuration-field local-endpoint-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row local-model-row" style="display: none;">
                            <ui:Label text="MODEL" class="field-label" />
                            <ui:TextField name="ai-arena-side-a-local-model-field" class="configuration-field local-model-field" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="ai-arena-side-b-ai-fields" class="ai-side-section ai-side-b-section ai-side-fields">
                        <ui:Label text="SIDE B" class="ai-side-title" />

                        <ui:VisualElement class="configuration-field-row">
                            <ui:Label text="AI PROVIDER" class="field-label" />
                            <ui:DropdownField name="ai-arena-side-b-provider-field" class="configuration-field ai-provider-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row openai-model-row">
                            <ui:Label text="MODEL" class="field-label" />
                            <ui:DropdownField name="ai-arena-side-b-model-field" class="configuration-field openai-model-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row api-key-row">
                            <ui:Label text="API KEY" class="field-label" />
                            <ui:TextField name="ai-arena-side-b-api-key-field" is-password-field="true" class="configuration-field api-key-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row local-endpoint-row" style="display: none;">
                            <ui:Label text="LOCAL ENDPOINT" class="field-label" />
                            <ui:TextField name="ai-arena-side-b-local-endpoint-field" class="configuration-field local-endpoint-field" />
                        </ui:VisualElement>

                        <ui:VisualElement class="configuration-field-row local-model-row" style="display: none;">
                            <ui:Label text="MODEL" class="field-label" />
                            <ui:TextField name="ai-arena-side-b-local-model-field" class="configuration-field local-model-field" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="ai-arena-configuration-error-label" class="configuration-error" style="display: none;" />

                <ui:VisualElement class="configuration-actions">
                    <ui:Button name="ai-arena-back-button" text="BACK" class="configuration-button configuration-back-button mode-button" />
                    <ui:Button name="ai-arena-start-match-button" text="START MATCH" class="configuration-button configuration-start-button mode-button primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
